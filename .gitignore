# ── Python ────────────────────────────────
__pycache__/
*.pyc
*.zip
.venv/

# ── Model ağırlıkları ─────────────────────
*.pt

# ── Çalışma zamanında üretilen veri artefaktları ─────────────────────────────
# NOT: Eski sürümdeki '*.*txt' / '*.json' gibi genel kurallar gereksinimler.txt
# gibi KAYNAK dosyaları da yuttuğu için kaldırıldı; yalnızca üretilen dosyalar
# açıkça yok sayılır (rapor 8.1.4).
turkce_metin.txt
sozluk.json
bpe_sozluk.json
talimat_verisi.json
yama_durumu.json
logs/
checkpoints/
# CKPT sözleşmeleri kaynak belgedir; model checkpoint'leriyle karıştırılmaz.
!docs/checkpoints/
!docs/checkpoints/**
# Manifestli deney koşuları; seçilmiş raporlar raporlar/ altında küratörlenir.
experiments/EXP-*/
# Tek-komutlu reproduce bundle'ları runtime kanıtıdır; seçilmiş sonuçlar docs/
# altında küratörlenir, ham EXP dizinleri Git'e alınmaz.
artifacts/

# Paket derleme çıktıları (CI package job ve yerel `python -m build`)
build/
dist/
site/
*.egg-info/
